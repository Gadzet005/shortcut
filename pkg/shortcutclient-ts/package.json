{
  "name": "@shortcut/client",
  "version": "0.1.0",
  "description": "TypeScript client for the Shortcut orchestrator",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test --import tsx src/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2"
  }
}
